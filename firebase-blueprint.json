  "firestore": {
    "users": {
      "schema": "UserProfile",
      "description": "Collection of user profiles and roles"
    },
    "inventory": {
      "schema": "InventoryItem",
      "description": "Collection of inventory items"
    },
    "incoming_goods": {
      "schema": "BarangMasukItem",
      "description": "Collection of incoming goods records"
    },
    "requests": {
      "schema": "PermintaanPersediaan",
      "description": "Collection of stock requests"
    },
    "outgoing_goods": {
      "schema": "BarangKeluarRecord",
      "description": "Collection of outgoing goods records"
    },
    "bmn_assets": {
      "schema": "BmnItem",
      "description": "Collection of state-owned assets"
    },
    "bmn_mutations": {
      "schema": "MutasiBmnRecord",
      "description": "Collection of BMN mutation records"
    },
    "room_bookings": {
      "schema": "PeminjamanRuang",
      "description": "Collection of room and BMN bookings"
    },
    "letters": {
      "schema": "SuratMasuk",
      "description": "Collection of incoming letters"
    },
    "dispositions": {
      "schema": "Disposisi",
      "description": "Collection of dispositions"
    },
    "activities": {
      "schema": "Kegiatan",
      "description": "Collection of calendar activities"
    }
  }
