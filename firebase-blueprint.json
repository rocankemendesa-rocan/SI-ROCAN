{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User profile and role information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "nip": { "type": "string" },
        "nik": { "type": "string" },
        "pin": { "type": "string" },
        "role": { "type": "string" },
        "roleTitle": { "type": "string" },
        "unit": { "type": "string" },
        "email": { "type": "string" }
      },
      "required": ["id", "name", "nip", "role", "pin"]
    },
    "InventoryItem": {
      "title": "Inventory Item",
      "description": "Stock item in the warehouse",
